  "cards": [
    {
      "dot": "cyan",
      "title": "Edit the right source",
      "items": [
        "content/*.json: service data, FAQs and guides.",
        "src/*.html: shared shell and homepage structure.",
        "scripts/supporting_pages.py: supporting-page copy/layout.",
        "dist/*.css, *.js and assets/: styles, behaviour and images."
      ]
    },
    {
      "dot": "emerald",
      "title": "Build and publish",
      "items": [
        "The Python build writes 16 HTML documents, including the 404 page.",
        "Pages packaging adds /dransal/ to local asset and navigation paths.",
        "CI verifies the artifact before deploying it.",
        "Sites uses dist/ through its existing hosting manifest; GitHub CI does not publish to Sites."
      ]
    },
    {
      "dot": "amber",
      "title": "What the care form actually does",
      "items": [
        "Service links can preselect the care category with ?care=...",
        "Category + timeframe produce a note in page memory.",
        "Copy/download uses the device; no enquiry API or booking is implemented.",
        "Google Fonts is an external network dependency."
      ]
    },
    {
      "dot": "rose",
      "title": "Preserve the brand",
      "items": [
        "Use assets/gentle-hands-logo.png unchanged in every logo placement.",
        "The shared header/footer affect all generated pages.",
        "Do not extract, regenerate, crop, recolour or replace the supplied logo.",
        "Source cards are pinned to the original-logo restoration commit."
      ]
    }
  ]
